{
  "adapter": "kotlin-gradle",
  "contractVersion": "KILN-COAL-CONTRACT-1",
  "execution": {
    "appendEntry": false,
    "driver": "command",
    "entryKind": "none",
    "environment": {
      "GRADLE_USER_HOME": "{specimen}/.gradle"
    },
    "rebuildCommands": [
      [
        "gradle",
        "--no-daemon",
        "classes"
      ]
    ],
    "testCommand": [
      "gradle",
      "--no-daemon",
      "test"
    ]
  },
  "languages": [
    "kotlin"
  ],
  "mutation": {
    "rules": [
      {
        "ignoreCase": false,
        "kind": "KOTLIN_TOKEN_REPLACEMENT",
        "pattern": "\\bfalse\\b|\\btrue\\b|!=|==|&&|\\|\\|",
        "replacements": {
          "!=": "==",
          "&&": "||",
          "==": "!=",
          "false": "true",
          "true": "false",
          "||": "&&"
        }
      }
    ],
    "strategy": "text-rules"
  },
  "proof": {
    "assertionPatterns": [
      "\\bassert(?:Equals|False|True)\\s*\\("
    ],
    "locationPatterns": [
      "FAIL (?P<path>[^:\\r\\n]+\\.kt):(?P<line>\\d+)"
    ],
    "parser": "generic",
    "testPatterns": [
      "^CASE (?P<test>[^\\r\\n]+)"
    ]
  },
  "schema": "kiln.coal-contract.v1",
  "sourceExtensions": [
    ".kt",
    ".kts"
  ]
}
