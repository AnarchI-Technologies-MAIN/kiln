{
  "adapter": "swift-swiftpm",
  "contractVersion": "KILN-COAL-CONTRACT-1",
  "execution": {
    "appendEntry": false,
    "driver": "command",
    "entryKind": "none",
    "environment": {},
    "rebuildCommands": [
      [
        "swift",
        "build",
        "--scratch-path",
        "{specimen}/.build"
      ]
    ],
    "testCommand": [
      "swift",
      "test",
      "--scratch-path",
      "{specimen}/.build"
    ]
  },
  "languages": [
    "swift"
  ],
  "mutation": {
    "rules": [
      {
        "ignoreCase": false,
        "kind": "SWIFT_TOKEN_REPLACEMENT",
        "pattern": "\\bfalse\\b|\\btrue\\b|!=|==|&&|\\|\\|",
        "replacements": {
          "!=": "==",
          "&&": "||",
          "==": "!=",
          "false": "true",
          "true": "false",
          "||": "&&"
        }
      }
    ],
    "strategy": "text-rules"
  },
  "proof": {
    "assertionPatterns": [
      "\\bXCTAssert(?:Equal|False|True)\\s*\\("
    ],
    "locationPatterns": [
      "(?P<path>[^:\\r\\n]+\\.swift):(?P<line>\\d+):"
    ],
    "parser": "generic",
    "testPatterns": [
      "^Test Case '-\\[(?P<test>[^]]+)\\]' failed"
    ]
  },
  "schema": "kiln.coal-contract.v1",
  "sourceExtensions": [
    ".swift"
  ]
}
